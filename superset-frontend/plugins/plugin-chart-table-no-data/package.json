{
  "name": "@superset-ui/plugin-chart-table-no-data",
  "version": "1.0.0",
  "description": "Superset Chart - Table with Empty State",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "files": [
    "esm",
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build-cjs && npm run build-esm",
    "build-cjs": "tsc -p tsconfig.json",
    "build-esm": "tsc -p tsconfig.esm.json",
    "dev": "webpack serve --config webpack.config.dev.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apache/superset.git"
  },
  "keywords": [
    "superset"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@superset-ui/chart-controls": "*",
    "@superset-ui/core": "*",
    "@superset-ui/plugin-chart-table": "*",
    "antd": "^4.10.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "dependencies": {
    "bignumber.js": "^9.0.0",
    "json-bigint": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
